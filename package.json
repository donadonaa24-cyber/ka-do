{
  "name": "yugioh-solo-sim",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:artifact": "tsc --noEmit && vite build && node scripts/build-artifact.mjs",
    "build:share": "tsc --noEmit && vite build && node scripts/build-artifact.mjs dist/share.html --no-images",
    "build:pages": "tsc --noEmit && vite build && node scripts/build-artifact.mjs pages/index.html --no-images --pages"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
